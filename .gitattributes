# Preserve the measured/generated input bytes, including csv.writer's CRLF.
# Scope this to the new stress inputs; existing datasets keep their attributes.
datasets/stress_*/map.csv -text whitespace=cr-at-eol
datasets/stress_*/queries.csv -text whitespace=cr-at-eol
datasets/stress_*/metadata.json -text

# Preserve the published final input bytes and their SHA-256 on Windows/Linux.
datasets/final_practice/** -text whitespace=cr-at-eol
